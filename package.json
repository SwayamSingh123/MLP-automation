{
  "name": "kraftshala-qa-automation",
  "version": "2.0.0",
  "private": true,
  "description": "Cypress automation for Kraftshala lead forms, downloads, KS Live, callback, SEO and broken links, published as an HTML dashboard.",
  "scripts": {
    "test": "node scripts/run.js --platform test",
    "test:main": "node scripts/run.js --platform main",
    "test:suite": "node scripts/run.js --platform test --suite",
    "open": "node scripts/run.js --open --platform test",
    "report": "node reporter/buildSite.js cypress/reports/site test cypress/reports/results-test.json",
    "serve": "node scripts/serve.js",
    "open:main": "node scripts/run.js --open --platform main"
  },
  "license": "ISC",
  "devDependencies": {
    "cypress": "^15.12.0"
  }
}
